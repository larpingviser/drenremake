SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    LoadCategory(CurrentCategory, SearchBox.Text)
end)

InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and InputBox.Text ~= "" then 
        local url = InputBox.Text:match("^https?://") and InputBox.Text or nil
        if url then ExecuteScript("Custom URL", url) else
            addLog("Not a valid URL.", Theme.Error)
        end
        InputBox.Text = ""
    end
end)

local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.Escape then 
        ScreenGui:Destroy() 
    end
    
    if MenuFrame.Visible and input.KeyCode == Enum.KeyCode.Tab then
        local tabs = {}
        for _, t in ipairs(MainTabs) do table.insert(tabs, t) end
        if Config.IsAdmin then
            for _, t in ipairs(AdminTabs) do table.insert(tabs, "★ " .. t) end
        end
        
        local index = 1
        for i, t in ipairs(tabs) do
            if t == CurrentCategory then index = i; break end
        end
        
        local isShift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        
        if isShift then
            index = index - 1
            if index < 1 then index = #tabs end
        else
            index = index + 1
            if index > #tabs then index = 1 end
        end
        
        CurrentCategory = tabs[index]
        BuildSidebar()
        LoadCategory(CurrentCategory, SearchBox.Text)
        addLog("Switched to: " .. CurrentCategory, Theme.TextDim)
    end
end)

