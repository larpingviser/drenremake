-- ==============================================================================
local function LoadConfig()
    local success, data = pcall(function()
        if isfile and isfile(Config.File) then
            return HttpService:JSONDecode(readfile(Config.File))
        end
    end)
    
    if success and data then
        if data.Favorites then Config.Favorites = data.Favorites end
        if data.Recent then Config.Recent = data.Recent end
        if data.CustomScripts then Config.CustomScripts = data.CustomScripts end
        if data.DynamicTabs then Config.DynamicTabs = data.DynamicTabs end
    end
end

local function SaveConfig()
    pcall(function()
        if writefile then
            local dataToSave = {
                Favorites = Config.Favorites,
                Recent = Config.Recent,
                CustomScripts = Config.CustomScripts,
                DynamicTabs = Config.DynamicTabs
            }
            writefile(Config.File, HttpService:JSONEncode(dataToSave))
        end
    end)
end

