local function ExecuteScript(name, url)
    addLog("Injecting " .. name .. "...", Theme.TextMain)
    
    if not table.find(Config.Recent, name) then
        table.insert(Config.Recent, 1, name)
        if #Config.Recent > 10 then table.remove(Config.Recent, 11) end
        SaveConfig()
    end

    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        
        if success then
            addLog("Successfully injected " .. name, Theme.Green)
            InputBox.Text = ""
        else
            addLog("Failed: " .. tostring(err), Theme.Error)
        end
    end)
end

local function BuildSidebar()
    for _, v in pairs(Sidebar:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local tabs = {}
    for _, t in ipairs(MainTabs) do table.insert(tabs, t) end
    if Config.IsAdmin then
        for _, t in ipairs(AdminTabs) do table.insert(tabs, "★ " .. t) end
    end
    
    for i, catName in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 20)
        btn.BackgroundTransparency = 1
        btn.Text = "[-] " .. catName
        btn.TextColor3 = (catName == CurrentCategory) and Theme.TextMain or Theme.TextDim
        btn.Font = Theme.Font
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = i
        btn.Parent = Sidebar
        
        btn.MouseButton1Click:Connect(function()
            CurrentCategory = catName
            BuildSidebar()
            LoadCategory(catName, SearchBox.Text)
        end)
    end
end

