            urlBox.Size = UDim2.new(0.5, -5, 0, 20)
            urlBox.BackgroundColor3 = Theme.TitleBar
            urlBox.PlaceholderText = "Raw URL"
            urlBox.TextColor3 = Theme.TextMain
            urlBox.Font = Theme.Font
            urlBox.Parent = ScrollFrame
            
            local saveBtn = Instance.new("TextButton")
            saveBtn.Size = UDim2.new(1, 0, 0, 20)
            saveBtn.BackgroundColor3 = Theme.Green
            saveBtn.Text = "[-] SAVE TO CUSTOM TAB"
            saveBtn.TextColor3 = Theme.Bg
            saveBtn.Font = Theme.Font
            saveBtn.Parent = ScrollFrame
            
            saveBtn.MouseButton1Click:Connect(function()
                if nameBox.Text ~= "" and urlBox.Text ~= "" then
                    Config.CustomScripts[nameBox.Text] = urlBox.Text
                    Database["Custom"][nameBox.Text] = urlBox.Text
                    SaveConfig()
                    addLog("Saved " .. nameBox.Text .. " to Custom", Theme.Green)
                end
            end)
            return
        else
            -- Check if this is a dynamic tab that holds a script
            if Database[catName] then
                local scriptData = nil
                for k, v in pairs(Database[catName]) do scriptData = {Name = k, Url = v} end
                if scriptData then
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 20)
                    btn.BackgroundTransparency = 1
                    btn.Text = "[-] Execute " .. scriptData.Name
                    btn.TextColor3 = Theme.Green
                    btn.Font = Theme.Font
                    btn.TextXAlignment = Enum.TextXAlignment.Left
                    btn.Parent = ScrollFrame
                    btn.MouseButton1Click:Connect(function()
                        ExecuteScript(scriptData.Name, scriptData.Url)
                    end)
                    return
                end
            end
            -- Generic Admin Tabs (Visual Only)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 20)
            lbl.BackgroundTransparency = 1
            lbl.Text = "[-] Admin Feature: " .. catName .. " executed."
            lbl.TextColor3 = Theme.Green
            lbl.Font = Theme.Font
            lbl.Parent = ScrollFrame
            return
        end
    end

    -- ===== HENRYNAH REPO =====
    if catName == "Henrynah Repo" then
        local fetchBtn = Instance.new("TextButton")
        fetchBtn.Size = UDim2.new(1, 0, 0, 20)
        fetchBtn.BackgroundColor3 = Theme.TitleBar
        fetchBtn.Text = "[-] Fetch Repo Tree (github.com/Henrynah/source)"
        fetchBtn.TextColor3 = Theme.TextMain
        fetchBtn.Font = Theme.Font
        fetchBtn.Parent = ScrollFrame
        
        fetchBtn.MouseButton1Click:Connect(function()
            fetchBtn.Text = "[-] Fetching... (wait)"
            task.spawn(function()
                local ok, res = pcall(function()
                    return HttpService:JSONDecode(game:HttpGet("https://api.github.com/repos/Henrynah/source/git/trees/main?recursive=1"))
                end)
                
                if ok and res.tree then
                    fetchBtn:Destroy()
                    for _, item in ipairs(res.tree) do
                        if item.type == "blob" and item.path:find("%.lua$") then
                            local fileBtn = Instance.new("TextButton")
                            fileBtn.Size = UDim2.new(1, 0, 0, 20)
                            fileBtn.BackgroundTransparency = 1
                            fileBtn.Text = "[-] " .. item.path
                            fileBtn.TextColor3 = Theme.TextDim
                            fileBtn.Font = Theme.Font
                            fileBtn.TextSize = 11
                            fileBtn.TextXAlignment = Enum.TextXAlignment.Left
                            fileBtn.Parent = ScrollFrame
                            
                            fileBtn.MouseButton1Click:Connect(function()
                                local url = "https://raw.githubusercontent.com/Henrynah/source/main/" .. item.path
                                ExecuteScript(item.path, url)
                            end)
                        end
                    end
                else
                    fetchBtn.Text = "[-] Failed to fetch. (Rate limit?)"
                end
            end)
        end)
        return
    end

    -- ===== NORMAL LISTS =====
    local list = Database[catName] or {}
    
    if catName == "Favorites" then
        for _, n in ipairs(Config.Favorites) do
            for _, c in pairs(Database) do
                if c[n] then table.insert(list, {Name = n, Url = c[n]}) end
            end
        end
    elseif catName == "Recent" then
        for _, n in ipairs(Config.Recent) do
            for _, c in pairs(Database) do
                if c[n] then table.insert(list, {Name = n, Url = c[n]}) end
            end
        end
    end

    local sorted = {}
    for k, v in pairs(list) do 
        local name = type(k) == "number" and v.Name or k
        local url = type(k) == "number" and v.Url or v
        if not filter or filter == "" or name:lower():find(filter:lower()) then 
            table.insert(sorted, {Name = name, Url = url}) 
        end
    end
    table.sort(sorted, function(a,b) return a.Name < b.Name end)

    for i, data in ipairs(sorted) do
        local isFav = table.find(Config.Favorites, data.Name)
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 20)
        btn.BackgroundTransparency = 1
        btn.Text = (isFav and "[-] ★ " or "[-]   ") .. "[" .. i .. "] " .. data.Name
        btn.TextColor3 = isFav and Theme.Green or Theme.TextDim
        btn.Font = Theme.Font
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ScrollFrame
        
        btn.MouseEnter:Connect(function() btn.TextColor3 = Theme.TextMain end)
        btn.MouseLeave:Connect(function() btn.TextColor3 = isFav and Theme.Green or Theme.TextDim end)
        
        btn.MouseButton1Click:Connect(function()
            ExecuteScript(data.Name, data.Url)
        end)
    end
end

